{
  "manifest_version": 3,
  "name": "KimiAccess",
  "version": "0.2.0",
  "description": "__MSG_extDescription__",
  "content_scripts": [
    {
      "matches": [
        "https://kimi.ai/*",
        "https://*.kimi.ai/*",
        "https://kimi.com/*",
        "https://*.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.kimi.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "default_locale": "en"
}